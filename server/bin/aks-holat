#!/usr/bin/env bash
# AKS TIZIM — server holati, bir qarashda. Ishlatish: aks-holat
set -uo pipefail
q() { sudo -u postgres psql -X -q -d aks_tizim -P pager=off "$@" 2>&1; }

echo "================ AKS SERVER HOLATI  $(date '+%d.%m.%Y %H:%M') ================"
if [ -f /opt/aks/app/.versiya ]; then
  echo "Kod versiyasi : $(git -C /opt/aks/repo log -1 --format='%h  %ad  %s' --date=format:'%d.%m %H:%M' 2>/dev/null)"
else
  echo "Kod versiyasi : hali o'rnatilmagan"
fi
echo "Avto-yangilash: $(systemctl is-active aks-yangila.timer 2>/dev/null)   Ko'zgu taymeri: $(systemctl is-active aks-kozgu.timer 2>/dev/null)"
echo "Xizmatlar     : postgres=$(systemctl is-active postgresql) redis=$(systemctl is-active redis-server) nginx=$(systemctl is-active nginx)"
API=$(curl -fsS -m 5 http://127.0.0.1:3000/api/holat 2>/dev/null || echo '')
if [ -n "$API" ]; then
  echo "Ilova serveri : ishlayapti — $(echo "$API" | tr -d '\n' | sed 's/.*"versiya":"\([^"]*\)".*/versiya \1/') · xodimlar: $(echo "$API" | grep -o '"xodimlar":[0-9]*' | cut -d: -f2) · ko'prik: $(echo "$API" | grep -o '"koprik":[a-z]*' | cut -d: -f2) · Index.html: $(echo "$API" | grep -o '"ui":[a-z]*' | cut -d: -f2)"
else
  echo "Ilova serveri : !!! JAVOB YO'Q (pm2 logs aks-api)"
fi
free -h | awk '/^Mem/{print "Xotira        : band "$3" / jami "$2" (bo'\''sh "$7")"} /^Swap/{print "Swap          : band "$3" / "$2}'
df -h / | awk 'NR==2{print "Disk          : band "$3" / "$2" ("$5")"}'

echo
echo "--- Oxirgi o'rnatishlar ---"
grep -E "OK:|XATO|ulanib" /var/log/aks-deploy.log 2>/dev/null | tail -3 || echo "(yo'q)"
if grep -q "!!!" <(tail -40 /var/log/aks-deploy.log 2>/dev/null); then
  echo "--- O'rnatish xatosi (oxirgi qatorlar) ---"; tail -15 /var/log/aks-deploy.log
fi

echo
echo "--- Ko'zgu: oxirgi 5 yurish ---"
q -c "SELECT to_char(boshlandi,'DD.MM HH24:MI:SS') AS vaqt, holat, varaqlar, ozgargan AS \"o'zgargan\", qatorlar,
             round(google_ms/1000.0,1) AS google_s, round(baza_ms/1000.0,1) AS baza_s, left(xato,90) AS xato
      FROM kozgu.yurishlar ORDER BY id DESC LIMIT 5;"
echo "--- Bazadagi varaqlar (eng kattalari) ---"
q -c "SELECT varaq, qatorlar, ustunlar, to_char(ozgargan,'DD.MM HH24:MI') AS \"o'zgargan\"
      FROM kozgu.varaqlar ORDER BY qatorlar DESC LIMIT 12;"
q -tA -c "SELECT 'Jami: '||count(*)||' varaq, '||coalesce(sum(qatorlar),0)||' qator. Baza hajmi: '||pg_size_pretty(pg_database_size('aks_tizim')) FROM kozgu.varaqlar;"
echo
echo "--- Ilova so'rovlari (oxirgi 24 soat): qaysi amal qayerda, necha ms ---"
q -c "SELECT fn AS amal, qayerda, soni, ortacha_ms, eng_sekin_ms, xatolar FROM v_rpc_24soat LIMIT 12;" 2>/dev/null | grep -v "^$" || echo "(hali so'rov yo'q)"
q -tA -c "SELECT 'Kirishlar (24 soat): '||count(*) FROM kirishlar WHERE vaqt > now()-interval '24 hours';" 2>/dev/null
if command -v redis-cli >/dev/null; then
  echo "📱 Telegram: $( [ "$(redis-cli --raw get yozuv_yondi:tg)" = 1 ] && echo "SERVERDAN (yozuv_yondi:tg)" || echo "Koprik orqali" ) · botdan keladiganlar: $( [ "$(redis-cli --raw get yozuv_yondi:tg_kirish)" = 1 ] && echo "SERVER o'qiydi (poll)" || echo "eski tgTugmaPoll" ) · isbot qarori: $( [ "$(redis-cli --raw get yozuv_yondi:tasdiq_qaror)" = 1 ] && echo SERVERDA || echo "eski tizim" )   (aks-tg, aks-tg-kirish, aks-tasdiq-qaror)"
echo "⏰ Vaqt bo'yicha ishlar: topAvto (har 2 soat)=$( [ "$(redis-cli --raw get vaqt_yondi:top_avto)" = 1 ] && echo SERVERDA || echo "eski triggerda" ) · oxirgi: $(redis-cli --raw get vaqt:top_avto:oxirgi 2>/dev/null | sed -E 's/.*"vaqt":"([^"]*)".*"ok":(true|false).*/\1 \2/; s/true/✅/; s/false/✖/' | head -c 60; [ -z "$(redis-cli --raw get vaqt:top_avto:oxirgi 2>/dev/null)" ] && echo -n "—" ) · topErtalab 08:30=$( [ "$(redis-cli --raw get vaqt_yondi:top_ertalab)" = 1 ] && echo SERVERDA || echo "eski triggerda" ) · topKechki 20:10=$( [ "$(redis-cli --raw get vaqt_yondi:top_kechki)" = 1 ] && echo SERVERDA || echo "eski triggerda" ) · undErtalab 09:00=$( [ "$(redis-cli --raw get vaqt_yondi:und_ertalab)" = 1 ] && echo SERVERDA || echo "eski triggerda" ) · monEslatma 09:10=$( [ "$(redis-cli --raw get vaqt_yondi:mon_eslatma)" = 1 ] && echo SERVERDA || echo "eski triggerda" ) · xatKechikkan 17:00=$( [ "$(redis-cli --raw get vaqt_yondi:xat_kechikkan)" = 1 ] && echo SERVERDA || echo "eski triggerda" ) · bekorKechikkan 17:15=$( [ "$(redis-cli --raw get vaqt_yondi:bekor_kechikkan)" = 1 ] && echo SERVERDA || echo "eski triggerda" ) · qadamKechki 18:00=$( [ "$(redis-cli --raw get vaqt_yondi:qadam_kechki)" = 1 ] && echo SERVERDA || echo "eski triggerda" ) · ijroKechki 18:15=$( [ "$(redis-cli --raw get vaqt_yondi:ijro_kechki)" = 1 ] && echo SERVERDA || echo "eski triggerda" ) · ijroTekshiruvTanla 09:30=$( [ "$(redis-cli --raw get vaqt_yondi:ijro_tanla)" = 1 ] && echo SERVERDA || echo "eski triggerda" ) · yuristKunlik 20:05=$( [ "$(redis-cli --raw get vaqt_yondi:yurist_kunlik)" = 1 ] && echo SERVERDA || echo "eski triggerda" ) · taminotEslatma du 09:00=$( [ "$(redis-cli --raw get vaqt_yondi:taminot_eslatma)" = 1 ] && echo SERVERDA || echo "eski triggerda" ) · kechkiHisobot 20:00=$( [ "$(redis-cli --raw get vaqt_yondi:kechki_hisobot)" = 1 ] && echo SERVERDA || echo "eski triggerda" ) · zaxira 02:00=$( [ "$(redis-cli --raw get vaqt_yondi:zaxira_kunlik)" = 1 ] && echo SERVERDA || echo "eski triggerda" ) · skanNaz 10daq=$( [ "$(redis-cli --raw get vaqt_yondi:skan_naz)" = 1 ] && echo SERVERDA || echo "eski tgTugmaPoll" ) · tqKechki 20:05=$( [ "$(redis-cli --raw get vaqt_yondi:tq_kechki)" = 1 ] && echo SERVERDA || echo "eski tgTugmaPoll" )   (aks-vaqt)"
  echo "Serverda yozish: to'lov=$( [ "$(redis-cli --raw get yozuv_yondi:tolov)" = 1 ] && echo YOQILGAN || echo "eski tizimda" ) · tashrif=$( [ "$(redis-cli --raw get yozuv_yondi:tashrif)" = 1 ] && echo YOQILGAN || echo "eski tizimda" ) · ta'minot=$( [ "$(redis-cli --raw get yozuv_yondi:taminot)" = 1 ] && echo YOQILGAN || echo "eski tizimda" ) · hujjat tuzatish=$( [ "$(redis-cli --raw get yozuv_yondi:hujjat)" = 1 ] && echo YOQILGAN || echo "eski tizimda" ) · topshiriq berish=$( [ "$(redis-cli --raw get yozuv_yondi:topshiriq)" = 1 ] && echo YOQILGAN || echo "eski tizimda" ) · tasdiqlash=$( [ "$(redis-cli --raw get yozuv_yondi:tasdiq)" = 1 ] && echo "TEZ (navbatda $(redis-cli --raw llen tasdiq_navbat))" || echo "eski tizimda" ) · xat bekor/reja=$( [ "$(redis-cli --raw get yozuv_yondi:mayda)" = 1 ] && echo YOQILGAN || echo "eski tizimda" ) · shartnoma/mijoz/ijara=$( [ "$(redis-cli --raw get yozuv_yondi:shartnoma)" = 1 ] && echo YOQILGAN || echo "eski tizimda" ) · reyestr Excel=$( [ "$(redis-cli --raw get yozuv_yondi:eksport)" = 1 ] && echo SERVERDA || echo "eski tizimda" ) · reyestr PDF=$( [ "$(redis-cli --raw get yozuv_yondi:eksport_pdf)" = 1 ] && echo SERVERDA || echo "eski tizimda" ) · hisobot PDF=$( [ "$(redis-cli --raw get yozuv_yondi:hisobot_pdf)" = 1 ] && echo SERVERDA || echo "eski tizimda" ) · bugungi ish amallari=$( [ "$(redis-cli --raw get yozuv_yondi:qadam)" = 1 ] && echo YOQILGAN || echo "eski tizimda" ) · tahrir/so'rovlar=$( [ "$(redis-cli --raw get yozuv_yondi:tahrir)" = 1 ] && echo YOQILGAN || echo "eski tizimda" ) · skan/hujjat/xat bekor (Bugungi ish)=$( [ "$(redis-cli --raw get yozuv_yondi:qadam_hujjat)" = 1 ] && echo YOQILGAN || echo "eski tizimda" ) · xat isboti=$( [ "$(redis-cli --raw get yozuv_yondi:xat_isbot)" = 1 ] && echo YOQILGAN || echo "eski tizimda" ) · topshiriq bajardim=$( [ "$(redis-cli --raw get yozuv_yondi:bajardim)" = 1 ] && echo YOQILGAN || echo "eski tizimda" ) · yuristga so'rov=$( [ "$(redis-cli --raw get yozuv_yondi:yurist_sorov)" = 1 ] && echo YOQILGAN || echo "eski tizimda" ) · xat chiqarish=$( [ "$(redis-cli --raw get yozuv_yondi:xat_chiqar)" = 1 ] && echo SERVERDA || echo "eski tizimda" ) · bekor qilish=$( [ "$(redis-cli --raw get yozuv_yondi:bekor)" = 1 ] && echo SERVERDA || echo "eski tizimda" )$( [ "$(redis-cli --raw get yozuv_yondi:bekor_word)" = 1 ] && echo " (+Word)" ) · yurist to'g'ridan/topshiriq=$( [ "$(redis-cli --raw get yozuv_yondi:yurist_ish)" = 1 ] && echo SERVERDA || echo "eski tizimda" ) · yurist hujjatlari=$( [ "$(redis-cli --raw get yozuv_yondi:yurist_hujjat)" = 1 ] && echo SERVERDA || echo "eski tizimda" ) · aloqa xati=$( [ "$(redis-cli --raw get yozuv_yondi:yurist_aloqa)" = 1 ] && echo SERVERDA || echo "eski tizimda" ) · qayta tuzish=$( [ "$(redis-cli --raw get yozuv_yondi:qayta)" = 1 ] && echo SERVERDA || echo "eski tizimda" )$( [ "$(redis-cli --raw get yozuv_yondi:qayta2)" = 1 ] && echo " (+tasdiq)" )$( [ "$(redis-cli --raw get yozuv_yondi:qayta_hujjat)" = 1 ] && echo " (+hujjatlar)" )$( [ "$(redis-cli --raw get yozuv_yondi:qayta_bekor)" = 1 ] && echo " (+bekor)" ) · shartnoma PDF=$( [ "$(redis-cli --raw get yozuv_yondi:shartnoma_pdf)" = 1 ] && echo SERVERDA || echo "eski tizimda" ) · tekshiruv javobi=$( [ "$(redis-cli --raw get yozuv_yondi:ijro_tekshir)" = 1 ] && echo YOQILGAN || echo "eski tizimda" ) · imzolanmagan ijara=$( [ "$(redis-cli --raw get yozuv_yondi:imzosiz)" = 1 ] && echo YOQILGAN || echo "eski tizimda" ) · kirim xat=$( [ "$(redis-cli --raw get yozuv_yondi:devon)" = 1 ] && echo YOQILGAN || echo "eski tizimda" )$( [ "$(redis-cli --raw get yozuv_yondi:devon_kordi)" = 1 ] && echo " (+ko'rdi)" )$( [ "$(redis-cli --raw get yozuv_yondi:devon2)" = 1 ] && echo " (+chiqim/rezolyutsiya/ijro/tasdiq)" )$( [ "$(redis-cli --raw get yozuv_yondi:devon_xat)" = 1 ] && echo " (+blankadagi xat)" ) · Topshiriqlarim yopish=$( [ "$(redis-cli --raw get yozuv_yondi:top_mening)" = 1 ] && echo SERVERDA || echo "eski tizimda" ) · mijoz kartasi PDF=$( [ "$(redis-cli --raw get yozuv_yondi:mijoz_karta_pdf)" = 1 ] && echo SERVERDA || echo "eski tizimda" ) · 07b kirish jurnali=$( [ "$(redis-cli --raw get yozuv_yondi:kirish07b)" = 1 ] && echo SERVERDA || echo "eski tizimda" ) · xodim ko'zi bilan=$( [ "$(redis-cli --raw get yozuv_yondi:sifat)" = 1 ] && echo "YANGI SAYTDA" || echo "eski saytda" ) · kelishuv hujjati=$( [ "$(redis-cli --raw get yozuv_yondi:kb)" = 1 ] && echo SERVERDA || echo "eski tizimda" )$( [ "$(redis-cli --raw get yozuv_yondi:kb2)" = 1 ] && echo " (+skan/bekor/tasdiq)" )$( [ "$(redis-cli --raw get yozuv_yondi:imzosiz_bekor)" = 1 ] && echo " · imzosiz darhol bekor=YOQILGAN" ) · topshiriq qoidalari (hozir)=$( [ "$(redis-cli --raw get yozuv_yondi:top_avto)" = 1 ] && echo SERVERDA || echo "eski tizimda" )"
  OG=$(redis-cli --raw llen yozuv_ogoh 2>/dev/null || echo 0)
  if [ "${OG:-0}" != "0" ]; then echo "!!! Yozuv ogohlantirishlari ($OG ta, oxirgilari):"; redis-cli --raw lrange yozuv_ogoh 0 4; fi
fi
echo "=================================================================================="
