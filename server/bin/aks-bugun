#!/usr/bin/env bash
# AKS TIZIM — bugungi faollik: kim kirdi (yangi server orqali) va qaysi amallar qancha vaqt oldi.
# Ishlatish: aks-bugun            — umumiy
#            aks-bugun und        — nomida «und» bor amallarning bugungi oxirgi 20 chaqiruvi (vaqti, qayerda, ms, xato)
#            aks-bugun koprik [N] — hali eski tizimga boradigan amallar (oxirgi N kun, odatda 3), umumiy kutish vaqti bo'yicha (keyingi ko'chirish navbati)
#            aks-bugun skan       — kim qaysi skanni ochdi (huquq «skan»)
#            aks-bugun xato [N]   — oxirgi N kundagi (odatda 3) XATO bilan tugagan chaqiruvlar (vaqti, amal, qayerda, xato matni)
#            aks-bugun <amal> [N] — nomida <amal> bor chaqiruvlar, oxirgi N kun (odatda bugun), oxirgi 20 tasi
q() { sudo -u postgres psql -X -q -d aks_tizim -P pager=off "$@" 2>&1; }
if [ "$1" = "koprik" ]; then
  KUN=$(echo "${2:-3}" | tr -cd '0-9'); KUN=${KUN:-3}
  echo "================ AKS — hali ESKI TIZIMGA boradigan amallar (oxirgi $KUN kun), umumiy kutish bo'yicha ================"
  SRV=$(cd /opt/aks/app && sudo -u aks -H node bin/amallar_royxat.js 2>/dev/null)
  [ -n "$SRV" ] && SRV="AND fn NOT IN ($SRV)"
  q -c "SELECT fn AS amal, count(*) soni, round(avg(ms)/1000.0,1) ortacha_s, round(sum(ms)/60000.0,1) jami_daqiqa, count(DISTINCT vaqt::date) kun FROM rpc_jurnal WHERE vaqt > now() - interval '$KUN days' AND qayerda = 'koprik' AND fn NOT IN (SELECT DISTINCT fn FROM rpc_jurnal WHERE qayerda = 'server' AND vaqt > now() - interval '$KUN days') $SRV GROUP BY 1 ORDER BY sum(ms) DESC LIMIT 30;"
  echo "(Serverga ko'chib bo'lgan amallar — hozir serverda bor bo'lganlari — bu ro'yxatda ko'rinmaydi.)"
  echo "--- Oxirgi $KUN kun: yangi saytdagi barcha so'rovlar qayerda bajarildi (server / kesh / koprik = eski tizim) ---"
  q -c "SELECT qayerda, count(*) soni, round(avg(ms)) ortacha_ms, count(DISTINCT fn) amallar FROM rpc_jurnal WHERE vaqt > now() - interval '$KUN days' GROUP BY 1 ORDER BY 2 DESC;"
  echo "--- Eski tizimga borgan BARCHA chaqiruvlar, server ichidan ketganlari ham (19.10.2026 dan yoziladi) — haqiqiy ko'chirish navbati ---"
  q -c "SELECT fn AS amal, count(*) soni, round(avg(ms)/1000.0,1) ortacha_s, round(sum(ms)/60000.0,1) jami_daqiqa, count(*) FILTER (WHERE NOT ok) xato FROM rpc_jurnal WHERE qayerda = 'eski' AND vaqt > now() - interval '$KUN days' GROUP BY 1 ORDER BY sum(ms) DESC LIMIT 30;"
  echo "--- Ishlayotgan xodimlar: yangi saytga (aks-tizim.uz) oxirgi kirishi va tizimdagi huquqlari ---"
  q -c "SELECT x.fish, coalesce(to_char(max(k.vaqt) AT TIME ZONE 'Asia/Tashkent','DD.MM.YYYY HH24:MI'), '— hech qachon') oxirgi_kirish, count(k.id) FILTER (WHERE k.vaqt > now() - interval '$KUN days') kirish_soni, CASE WHEN coalesce(array_length(x.huquqlar, 1), 0) = 0 THEN '— huquq yo''q' WHEN length(x.kirish_kodi) < 8 THEN '— kodi yo''q' ELSE array_to_string(x.huquqlar, ',') END huquqlar FROM v_xodimlar x LEFT JOIN kirishlar k ON k.fish = x.fish AND k.kompaniya_id = 1 WHERE x.kompaniya_id = 1 AND x.holat = 'Ishlayapti' GROUP BY x.fish, x.huquqlar, x.kirish_kodi ORDER BY max(k.vaqt) NULLS FIRST, x.fish;"
  exit 0
fi
if [ "$1" = "skan" ]; then
  echo "================ AKS — kim qaysi skanni ochdi (oxirgi 40 ta, yangilari tepada) ================"
  redis-cli --raw lrange skan_jurnal 0 39 | python3 -c "import sys,json
for l in sys.stdin:
  l=l.strip()
  if not l: continue
  try: x=json.loads(l); print(x.get('vaqt',''),'|',x.get('fish',''),'|',x.get('no',''),'|',x.get('nom',''))
  except Exception: print(l)"
  exit 0
fi
if [ "$1" = "xato" ]; then
  KUN=$(echo "${2:-3}" | tr -cd '0-9'); KUN=${KUN:-3}
  echo "================ AKS — XATO bilan tugagan chaqiruvlar (oxirgi $KUN kun) ================"
  q -c "SELECT to_char(vaqt,'DD.MM HH24:MI') vaqt, fn AS amal, qayerda, ms, left(xato,110) xato FROM rpc_jurnal WHERE NOT ok AND vaqt > now() - interval '$KUN days' ORDER BY id DESC LIMIT 40;"
  exit 0
fi
if [ -n "$1" ]; then
  F=$(printf '%s' "$1" | tr -cd 'A-Za-z0-9_')
  KUN=$(echo "${2:-0}" | tr -cd '0-9'); KUN=${KUN:-0}
  if [ "$KUN" = 0 ]; then SH="vaqt::date = current_date"; DAVR="bugun $(date '+%d.%m.%Y %H:%M')"; else SH="vaqt > now() - interval '$KUN days'"; DAVR="oxirgi $KUN kun"; fi
  echo "================ AKS — «$F» amallari, $DAVR ================"
  q -c "SELECT to_char(vaqt,'DD.MM HH24:MI:SS') vaqt, fn AS amal, qayerda, ms, CASE WHEN ok THEN '' ELSE left(xato,90) END xato FROM rpc_jurnal WHERE $SH AND fn ILIKE '%$F%' ORDER BY id DESC LIMIT 20;"
  exit 0
fi
echo "================ AKS — BUGUN  $(date '+%d.%m.%Y %H:%M') ================"
echo "--- Yangi server orqali kirganlar ---"
q -c "SELECT to_char(min(vaqt),'HH24:MI') birinchi, to_char(max(vaqt),'HH24:MI') oxirgi, count(*) marta, fish FROM kirishlar WHERE vaqt::date = current_date GROUP BY fish ORDER BY 1;"
echo "--- Amallar (bugun): qayerda, nechta, o'rtacha va eng sekin (ms), xatolar ---"
q -c "SELECT fn AS amal, qayerda, count(*) soni, round(avg(ms)) ortacha_ms, max(ms) eng_sekin, count(*) FILTER (WHERE NOT ok) xato FROM rpc_jurnal WHERE vaqt::date = current_date GROUP BY 1,2 ORDER BY 3 DESC LIMIT 25;"
echo "--- Oxirgi xatolar ---"
q -c "SELECT to_char(vaqt,'HH24:MI:SS') vaqt, fn, left(xato,80) xato FROM rpc_jurnal WHERE vaqt::date = current_date AND NOT ok ORDER BY id DESC LIMIT 6;"
