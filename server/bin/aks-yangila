#!/usr/bin/env bash
# AKS TIZIM — GitHub'dagi yangi kodni olib, o'rnatish. Taymer har daqiqada chaqiradi.
# Qo'lda: aks-yangila majburiy   (yangi kod bo'lmasa ham qayta o'rnatadi; tutun sinovi QAYTA o'tkaziladi)
#        aks-yangila sinovsiz   (tutun sinovisiz o'rnatadi — faqat sinovning o'zi adashgan bo'lsa)
set -uo pipefail
REPO=/opt/aks/repo
LOG=/var/log/aks-deploy.log
exec 9>/run/aks-yangila.lock
flock -n 9 || exit 0

cd "$REPO" || { echo "$(date '+%F %T') $REPO topilmadi" >>"$LOG"; exit 1; }
ESKI=$(git rev-parse HEAD 2>/dev/null || echo yoq)
if ! git fetch -q origin main 2>>"$LOG"; then
  echo "$(date '+%F %T') GitHub'ga ulanib bo'lmadi" >>"$LOG"; exit 1
fi
git reset -q --hard origin/main
YANGI=$(git rev-parse HEAD)
ORNATILGAN=$(cat /opt/aks/app/.versiya 2>/dev/null || echo yoq)

# 🧪 tutun sinovidan o'tmagan versiya (deploy.sh /opt/aks/.sinov_yiqildi ga yozadi) har daqiqada qayta sinalmaydi — tuzatilgan versiya kutiladi.
YIQILGAN=$(cat /opt/aks/.sinov_yiqildi 2>/dev/null || echo yoq)
REJIM=${1:-}
if [ -z "$REJIM" ] && [ "$YANGI" = "$YIQILGAN" ]; then exit 0; fi

if [ "$YANGI" != "$ORNATILGAN" ] || [ "$REJIM" = "majburiy" ] || [ "$REJIM" = "sinovsiz" ]; then
  if [ "$REJIM" = "sinovsiz" ]; then export AKS_SINOVSIZ=1; fi
  if bash "$REPO/server/deploy.sh" >>"$LOG" 2>&1; then
    if [ "$(cat /opt/aks/app/.versiya 2>/dev/null)" = "$YANGI" ]; then echo "$(date '+%F %T') OK: $(git log -1 --format='%h %s')" >>"$LOG"
    else echo "$(date '+%F %T') !!! O'RNATILMADI — tutun sinovidan o'tmadi: $(git log -1 --format='%h %s')" >>"$LOG"; fi
  else
    echo "$(date '+%F %T') !!! O'RNATISHDA XATO ($(git log -1 --format='%h')) — yuqoridagi qatorlarga qarang" >>"$LOG"
    exit 1
  fi
fi
