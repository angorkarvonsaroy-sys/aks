#!/usr/bin/env bash
# AKS TIZIM — 💾 server bazasi (aks_tizim) zaxirasini SHIFRLAB serverdan tashqariga — Google Drive (01.11.2026; 03.11 dan «AKS ARXIV / 98 SERVER BAZASI», zaxira yo'l — «gdrive:aks-zaxira»).
# Usul — shajara bilan bir xil (/opt/shajara/app/deploy/zaxira.sh): age ochiq kalit bilan shifrlash, rclone bilan Drive'ga.
#   aks-zaxira-tashqi          — eng oxirgi /var/backups/aks/aks_tizim_*.sql.gz ni shifrlab yuboradi (taymer: har kuni 03:30, aks-backup 03:00 dan keyin)
#   aks-zaxira-tashqi tekshir  — Drive'dagi fayllar ro'yxati (hech narsa yubormaydi)
# Ochiq kalit: ZAXIRA_OCHIQ_KALIT yoki /opt/aks/zaxira-ochiq-kalit.txt; u yo'q bo'lsa — shajara ochiq kaliti (/opt/shajara/zaxira-ochiq-kalit.txt).
# OCHISH uchun maxfiy kalit serverda emas — direktorda turishi shart (aks holda server yo'qolsa nusxa ham ochilmaydi).
# rclone — shajara-zaxira.service dagi foydalanuvchi va sozlama bilan (bir xil Drive ulanishi). Drive'da 30 kundan eskisi o'chiriladi.
set -uo pipefail
D=/var/backups/aks; T=$D/tashqi
REMOTE=${ZAXIRA_TASHQI:-gdrive:aks-zaxira}
PUB=${ZAXIRA_OCHIQ_KALIT:-/opt/aks/zaxira-ochiq-kalit.txt}; [ -s "$PUB" ] || PUB=/opt/shajara/zaxira-ochiq-kalit.txt
SV=shajara-zaxira.service
RU=$(systemctl show "$SV" -p User --value 2>/dev/null); RU=${RU:-root}
RCONF=$(systemctl show "$SV" -p Environment --value 2>/dev/null | grep -oE 'RCLONE_CONFIG=[^ ]+' | cut -d= -f2 | head -1)
RC() { if [ "$RU" = root ]; then env ${RCONF:+RCLONE_CONFIG=$RCONF} timeout 300 rclone "$@"; else sudo -u "$RU" -H env ${RCONF:+RCLONE_CONFIG=$RCONF} timeout 300 rclone "$@"; fi; }
# 03.11.2026: natija «Tizim holati» sahifasi uchun /opt/aks/holat/zaxira_tashqi.json ga (ilova serveri /var/backups/aks ni ko'ra olmaydi — u yopiq qoladi)
HOLAT=/opt/aks/holat/zaxira_tashqi.json
holat() {
  local f="${F:-}" bv="" h=0; [ -n "$f" ] && [ -f "$f" ] && { bv=$(date -Is -r "$f"); h=$(stat -c %s "$f"); }
  mkdir -p /opt/aks/holat && chmod 755 /opt/aks/holat
  printf '{"vaqt":"%s","ok":%s,"baza":"%s","baza_vaqt":"%s","hajm":%s,"matn":"%s"}\n' "$(date -Is)" "$1" "$(basename "${f:-}")" "$bv" "$h" "$(printf '%s' "$2" | tr -d '"\\' | tr '\n' ' ' | head -c 300)" >"$HOLAT.tmp" \
    && chmod 644 "$HOLAT.tmp" && mv "$HOLAT.tmp" "$HOLAT"
}
xato() { echo "⛔ $*"; holat false "$*" 2>/dev/null; exit 1; }

command -v rclone >/dev/null || xato "rclone o'rnatilmagan"
if [ "${1:-}" = tekshir ]; then
  echo "Drive: $REMOTE (rclone foydalanuvchisi: $RU)"
  RC lsl "$REMOTE" 2>&1 | sort -k2,3 | tail -10
  exit 0
fi
command -v age >/dev/null || xato "age o'rnatilmagan"
[ -s "$PUB" ] || xato "ochiq kalit topilmadi ($PUB)"
F=$(ls -t "$D"/aks_tizim_*.sql.gz 2>/dev/null | head -1)
[ -n "$F" ] || xato "zaxira fayli yo'q ($D) — aks-backup ishlamagan"
mkdir -p "$T" && chmod 755 "$T"
OUT="$T/$(basename "$F").age"
if [ ! -s "$OUT" ]; then
  age --encrypt --recipients-file "$PUB" --output "$OUT.tmp" "$F" || xato "shifrlab bo'lmadi"
  mv "$OUT.tmp" "$OUT" && chmod 644 "$OUT"
fi
# 03.11.2026: avval — AKS arxivi ulanishi (direktor hisobi, «AKS TIZIM / AKS ARXIV / 98 SERVER BAZASI», lib/arxiv.js bilan bir xil; rclone aks nomidan —
# ulanish fayli aks ga tegishli qolsin). 03.11 kechasi eski yo'l (gdrive:aks-zaxira) xato berdi — u endi faqat zaxira yo'l. Xato matni holat fayliga tushadi.
# 01.11: rclone boshqa foydalanuvchi nomidan ishlaydi — /var/backups/aks u uchun yopiq. Shuning uchun fayl root tomonidan stdin orqali beriladi (rclone rcat).
AKONF=/opt/aks/rclone.conf
APAPKA=$(grep -E '^ARXIV_PAPKA=' /opt/aks/.env 2>/dev/null | tail -1 | cut -d= -f2- | tr -d "\"' "); APAPKA=${APAPKA:-1xJGD7CpL5qdHoTEvPfikmedl58FpOkGC}
ARC() { sudo -u aks -H timeout 300 rclone --config "$AKONF" --drive-root-folder-id "$APAPKA" --tpslimit 3 --drive-pacer-min-sleep 200ms --low-level-retries 10 "$@"; }   # 07.11: Drive rateLimitExceeded
ERRF=$(mktemp); YER=""; XAT=""
if [ -z "${ZAXIRA_TASHQI:-}" ] && [ -s "$AKONF" ]; then
  if ARC rcat "aksarxiv:98 SERVER BAZASI/$(basename "$OUT")" <"$OUT" 2>"$ERRF"; then
    YER="AKS ARXIV / 98 SERVER BAZASI"; ARC delete --min-age 30d "aksarxiv:98 SERVER BAZASI" >/dev/null 2>&1 || true
  else XAT="arxiv: $(tail -c 200 "$ERRF" | tr '\n' ' ')"; fi
fi
if [ -z "$YER" ]; then
  if RC rcat "$REMOTE/$(basename "$OUT")" <"$OUT" 2>"$ERRF"; then YER="$REMOTE"; RC delete --min-age 30d "$REMOTE" >/dev/null 2>&1 || true
  else XAT="${XAT:+$XAT · }$REMOTE: $(tail -c 200 "$ERRF" | tr '\n' ' ')"; fi
fi
rm -f "$ERRF"
[ -n "$YER" ] || xato "Drive'ga yuborib bo'lmadi — $XAT"
find "$T" -name '*.age' -mtime +14 -delete
echo "✅ $(basename "$OUT") ($(du -h "$OUT" | cut -f1)) → $YER · kalit: $PUB"
IZ=""; [ -n "$XAT" ] && IZ=" (birinchi yo'l xatosi: $XAT)"
holat true "$(basename "$OUT") → $YER$IZ" 2>/dev/null || true
